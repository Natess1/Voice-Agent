{
  "name": "voice-agent-bridge",
  "displayName": "Voice Agent Bridge",
  "description": "Local bridge between VS Code and the voice agent",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Voice Agent Bridge",
      "properties": {
        "voiceAgent.port": {
          "type": "number",
          "default": 8765,
          "description": "Port of the local server (127.0.0.1)."
        },
        "voiceAgent.tokenFile": {
          "type": "string",
          "default": "D:\\voice-agent\\vscode_token.txt",
          "description": "File where the access token is written at startup."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.90.0",
    "typescript": "^5.4.0"
  }
}
